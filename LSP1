<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Scan to open the site map</title>
<style>
  :root { --bg: #ffffff; --text: #1d2430; --muted: #5b6573; color-scheme: light; }
  @media (prefers-color-scheme: dark) { :root { --bg: #1f2630; --text: #f1f3f6; --muted: #aab3bf; color-scheme: dark; } }
  body {
    margin: 0; min-height: 100vh; display: grid; place-items: center;
    background: var(--bg); color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    text-align: center; padding: 24px;
  }
  h1 { font-size: 2rem; margin: 0 0 6px; }
  p { color: var(--muted); margin: 0 0 24px; }
  #qr { background: #fff; padding: 18px; border-radius: 12px; display: inline-block; }
  #url { margin-top: 18px; font-size: .9rem; word-break: break-all; color: var(--muted); }
  button { margin-top: 20px; font: inherit; font-weight: 650; padding: 12px 20px; border-radius: 12px; border: 0; background: #f2c200; color: #1d2430; cursor: pointer; }
  @media print { button { display: none; } body { background: #fff; color: #000; } p, #url { color: #333; } }
</style>
</head>
<body>
<main>
  <h1>Site walk map</h1>
  <p>Scan with your phone camera. Nothing to install.</p>
  <div id="qr"></div>
  <div id="url"></div>
  <button type="button" onclick="window.print()">Print this page</button>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
  // Points at index.html in the same folder as this page.
  const mapUrl = new URL("./", location.href).href;
  document.getElementById("url").textContent = mapUrl;
  new QRCode(document.getElementById("qr"), {
    text: mapUrl, width: 280, height: 280, correctLevel: QRCode.CorrectLevel.M
  });
</script>
</body>
</html>

